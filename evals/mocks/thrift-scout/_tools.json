{
  "tools": [
    {
      "name": "search_shops",
      "description": "Search Japanese second-hand shop chains (Hard Off, BOOKOFF, Treasure Factory) for used items.\n\nkeywords: short search words as sold in Japan, e.g. 'WH-1000XM5'. max_price: yen budget.\nchains: any of hardoff, bookoff, trefac (default all). home_station: Japanese station name for\nin-store pick-up; results are then sorted by train time to each branch (when known), else by price.",
      "inputSchema": {
        "properties": {
          "keywords": {
            "title": "Keywords",
            "type": "string"
          },
          "max_price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Price"
          },
          "chains": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chains"
          },
          "home_station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Home Station"
          }
        },
        "required": [
          "keywords"
        ],
        "title": "search_shopsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "market_price",
      "description": "Typical used price in Japan from recent Yahoo! Auctions sales: median, middle-half range (low-high), number of\nsales and the oldest sale date. None when there are too few sales. keywords: model name, e.g. 'WH-1000XM5'.",
      "inputSchema": {
        "properties": {
          "keywords": {
            "title": "Keywords",
            "type": "string"
          }
        },
        "required": [
          "keywords"
        ],
        "title": "market_priceArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "market_priceOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "commute_time",
      "description": "Fastest train time between two stations in Japan, e.g. commute_time('吹田', '江坂').",
      "inputSchema": {
        "properties": {
          "from_station": {
            "title": "From Station",
            "type": "string"
          },
          "to_station": {
            "title": "To Station",
            "type": "string"
          }
        },
        "required": [
          "from_station",
          "to_station"
        ],
        "title": "commute_timeArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "commute_timeOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "plan_trip",
      "description": "Plan one train trip to pick up several used items in store: which branch to visit for each item and in what\norder, with train time and fare per leg and totals.\n\nFirst run search_shops with home_station for each item and choose the real matches yourself. Then pass, for each\nitem (at most 3), 1-2 of those listings as options: want (the item, e.g. 'headphones'; same want = alternatives),\ntitle, url, price, branch, and address (the listing's branch_station). Only listings with a branch work\n(Hard Off, Treasure Factory). Branches more than max_minutes from home are left out (suggest shipping).",
      "inputSchema": {
        "$defs": {
          "Option": {
            "properties": {
              "want": {
                "title": "Want",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "price": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Price"
              },
              "branch": {
                "title": "Branch",
                "type": "string"
              },
              "address": {
                "title": "Address",
                "type": "string"
              }
            },
            "required": [
              "want",
              "title",
              "url",
              "branch",
              "address"
            ],
            "title": "Option",
            "type": "object"
          }
        },
        "properties": {
          "home_station": {
            "title": "Home Station",
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/$defs/Option"
            },
            "title": "Options",
            "type": "array"
          },
          "round_trip": {
            "default": true,
            "title": "Round Trip",
            "type": "boolean"
          },
          "max_minutes": {
            "default": 120,
            "title": "Max Minutes",
            "type": "integer"
          }
        },
        "required": [
          "home_station",
          "options"
        ],
        "title": "plan_tripArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}